# ============================================================
# SOLANA SNIPER BOT — CONFIGURATION
# ============================================================

# ---- Security & Wallets ----

# Your VAULT wallet private key (base58 encoded)
# This wallet holds your main funds.
PRIVATE_KEY=your_vault_private_key_here

# Your SIGNER wallet private key (base58 encoded)
# This wallet is used for signing transactions and high-frequency swaps.
# It only needs a small SOL buffer (refilled automatically from Vault).
# Generate a new one with: node scripts/generate-signer.js
SIGNER_PRIVATE_KEY=

# Min SOL buffer to maintain on the SIGNER wallet for gas
VAULT_MIN_BALANCE_SOL=0.0174

# Amount to refill SIGNER from VAULT when it drops below minimum
SIGNER_REFILL_AMOUNT=0.0174

# ---- RPC & API Keys ----

# Solana RPC — use a paid one for speed (Helius, QuickNode, Triton)
RPC_URL=https://api.mainnet-beta.solana.com
RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com

# Helius API key for enhanced pool detection & asset fetching
HELIUS_API_KEY=

# Optional: Jupiter API Key for higher rate limits (developers.jup.ag)
JUPITER_API_KEY=

# Telegram Notifications (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# TRADING PARAMETERS
# ============================================================

# SOL amount to spend per snipe (Fixed mode)
BUY_AMOUNT_SOL=0.01

# Take profit multiplier (1.35 = 35% profit)
TAKE_PROFIT_MULTIPLIER=1.35

# Stop loss percent (15 = 15% drop)
STOP_LOSS_PERCENT=15

# Max slippage tolerance in percent
SLIPPAGE_PERCENT=10

# Max tokens to hold simultaneously
MAX_POSITIONS=2

# Maximum priority fee to pay for fast execution (in SOL)
MAX_PRIORITY_FEE_SOL=0.0001

# Force close position after X minutes (safety)
MAX_HOLD_MINUTES=15

# ============================================================
# GRADUATED SCALING (Dynamic Buy Amount)
# ============================================================

# Set to true to automatically adjust trade size based on Bankroll
USE_GRADUATED_SCALING=false

# Bankroll range in USD for scaling logic
SCALING_MIN_BALANCE=5
SCALING_MAX_BALANCE=50

# JSON array of scaling phases: [{"min": USD, "max": USD, "fraction": 0.XX}]
# fraction is the % of total bankroll allocated across all MAX_POSITIONS.
SCALING_PHASES='[{"min":5,"max":10,"fraction":0.20},{"min":10,"max":20,"fraction":0.30},{"min":20,"max":50,"fraction":0.50},{"min":50,"max":1000000,"fraction":0.70}]'

# ============================================================
# SAFETY FILTERS
# ============================================================

# Minimum liquidity in USD before sniping
MIN_LIQUIDITY_USD=100

# Minimum SOL liquidity in the pool
MIN_SOL_LIQUIDITY=0.5

# Maximum liquidity (avoid already-pumped tokens)
MAX_LIQUIDITY_USD=500000

# Safety checks
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
HONEYPOT_CHECK=true

# RugCheck.xyz Score Threshold (0-1000, higher = safer)
RUGCHECK_MIN_SCORE=500

# ============================================================
# SCANNER SETTINGS
# ============================================================

# Enable the DexScreener/Helius scanner for new pairs
SCANNER_ENABLED=true
SCANNER_POLL_INTERVAL=5000

# ============================================================
# MODE
# ============================================================

# Set true to simulate without real money
PAPER_TRADING=false
