# ===========================================
# SniperBOT Environment Configuration
# ===========================================
# Copy values from your existing setup

# REQUIRED - Wallet Configuration
PRIVATE_KEY=your_vault_private_key_here
SIGNER_PRIVATE_KEY=your_signer_private_key_here

# REQUIRED - RPC (Helius recommended)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
RPC_URL_FALLBACK=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=your_helius_api_key

# REQUIRED - Telegram (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===========================================
# Trading Settings
# ===========================================
BUY_AMOUNT_SOL=0.0174
SLIPPAGE_PERCENT=10
TAKE_PROFIT_MULTIPLIER=1.4
STOP_LOSS_PERCENT=25
MAX_POSITIONS=3

# ===========================================
# Safety Filters
# ===========================================
MIN_LIQUIDITY_USD=500
MAX_LIQUIDITY_USD=500000
MIN_INITIAL_LIQUIDITY_SOL=0.5
MIN_INITIAL_LIQUIDITY_USD=1000
MIN_LP_BURNED_PERCENT=0
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
HONEYPOT_CHECK=true
RUGCHECK_ENABLED=true
RUGCHECK_MIN_SCORE=500

# ===========================================
# VAULT Settings
# ===========================================
VAULT_MIN_BALANCE_SOL=0.0174
SIGNER_REFILL_AMOUNT=0.0174

# ===========================================
# Limit Order Settings
# ===========================================
LIMIT_ORDER_EXPIRY_MINUTES=10

# ===========================================
# MODE - SET TO false FOR LIVE TRADING!
# ===========================================
PAPER_TRADING=true

# ===========================================
# Advanced - Shinobi WebSocket
# ===========================================
USE_SHINOBI_WS=false
MIN_TRADE_VOLUME_SOL=0.3
VOLUME_GROWTH_RATE=0.3
SHINOBI_DEXS=pumpfun,raydium,jupiter,orca,pumpswap