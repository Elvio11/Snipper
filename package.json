  "version": "1.0.0",
  "description": "Solana meme token sniper bot - Production",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop sniper",
